{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "properties": {
    "replicas": { "type": "integer", "minimum": 1 },
    "gateway": {
      "type": "object",
      "properties": {
        "maxInFlight": { "type": "integer", "minimum": 1 },
        "queueWait": { "type": "string", "pattern": "^[0-9]+(ms|s)$" },
        "queryTimeout": { "type": "string", "pattern": "^[0-9]+(ms|s)$" },
        "chunkRows": { "type": "integer", "minimum": 1, "maximum": 100000 },
        "gpuCacheTTL": { "type": "string", "pattern": "^[0-9]+(ms|s|m)$" },
        "drainDelaySeconds": { "type": "integer", "minimum": 0 },
        "shutdownGraceSeconds": { "type": "integer", "minimum": 1 },
        "logLevel": { "type": "string", "enum": ["debug", "info", "warn", "error"] }
      }
    },
    "clickhouse": {
      "type": "object",
      "properties": {
        "addr": { "type": "string", "minLength": 1 },
        "user": { "type": "string", "minLength": 1 }
      }
    },
    "nodePort": {
      "type": "object",
      "properties": {
        "enabled": { "type": "boolean" },
        "port": { "type": "integer", "minimum": 30000, "maximum": 32767 }
      }
    },
    "service": {
      "type": "object",
      "properties": {
        "type": { "type": "string", "enum": ["ClusterIP", "NodePort", "LoadBalancer"] },
        "port": { "type": "integer", "minimum": 1, "maximum": 65535 },
        "adminPort": { "type": "integer", "minimum": 1, "maximum": 65535 }
      }
    }
  }
}
