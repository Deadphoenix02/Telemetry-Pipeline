{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "properties": {
    "streamer": {
      "type": "object",
      "properties": {
        "replicas": { "type": "integer", "minimum": 0, "maximum": 10 },
        "rateRowsPerSec": { "type": "integer", "minimum": 1, "maximum": 100000 },
        "tick": { "type": "string", "pattern": "^[0-9]+(ms|s)$" },
        "target": { "type": "string" },
        "mode": { "type": "string", "enum": ["auto", "memory", "stream"] },
        "maxMemoryMB": { "type": "integer", "minimum": 1 },
        "graceSeconds": { "type": "integer", "minimum": 1 },
        "logLevel": { "type": "string", "enum": ["debug", "info", "warn", "error"] },
        "window": { "type": "string", "pattern": "^[0-9]+(ms|s)$" },
        "windowMaxRecords": { "type": "integer", "minimum": 100 },
        "connectTimeout": { "type": "string", "pattern": "^[0-9]+(ms|s)$" },
        "ackTimeout": { "type": "string", "pattern": "^[0-9]+(ms|s)$" },
        "homeProbe": { "type": "string", "pattern": "^[0-9]+(ms|s)$" }
      }
    },
    "brokers": {
      "type": "object",
      "properties": {
        "replicas": { "type": "integer", "minimum": 0, "maximum": 5 },
        "statefulSet": { "type": "string", "minLength": 1 },
        "headlessService": { "type": "string", "minLength": 1 },
        "port": { "type": "integer", "minimum": 1, "maximum": 65535 }
      }
    },
    "service": {
      "type": "object",
      "properties": { "port": { "type": "integer", "minimum": 1, "maximum": 65535 } }
    }
  }
}
