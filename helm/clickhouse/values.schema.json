{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "properties": {
    "topology": {
      "type": "object",
      "properties": {
        "mode": { "type": "string", "enum": ["single", "replicated"] },
        "clusterName": { "type": "string", "pattern": "^[A-Za-z0-9_]+$" },
        "shards": { "type": "integer", "minimum": 1 },
        "replicas": { "type": "integer", "minimum": 1 }
      }
    },
    "retention": {
      "type": "object",
      "properties": {
        "ttl": { "type": "string", "pattern": "^[0-9]+ (HOUR|DAY)$" },
        "partition": { "type": "string", "enum": ["hour", "day"] }
      }
    },
    "keeper": {
      "type": "object",
      "properties": {
        "replicas": { "type": "integer", "minimum": 3 },
        "metricsPort": { "type": "integer", "minimum": 1, "maximum": 65535 }
      }
    },
    "clickhouse": {
      "type": "object",
      "properties": {
        "preStopSleepSeconds": { "type": "integer", "minimum": 0 },
        "shutdownWaitSeconds": { "type": "integer", "minimum": 0 },
        "terminationGracePeriodSeconds": { "type": "integer", "minimum": 1 },
        "config": {
          "type": "object",
          "properties": {
            "maxServerMemoryRatio": { "type": "number", "exclusiveMinimum": 0, "maximum": 1 },
            "backgroundPoolSize": { "type": "integer", "minimum": 1 },
            "threadPools": { "type": "object", "additionalProperties": { "type": "integer", "minimum": 1 } }
          }
        }
      }
    },
    "limits": {
      "type": "object",
      "properties": {
        "api": {
          "type": "object",
          "properties": {
            "maxExecutionTime": { "type": "integer", "minimum": 1 },
            "maxMemoryUsage": { "type": "integer", "minimum": 1 },
            "maxResultRows": { "type": "integer", "minimum": 1 },
            "maxRowsToRead": { "type": "integer", "minimum": 1 },
            "maxConcurrentQueries": { "type": "integer", "minimum": 1 }
          }
        }
      }
    },
    "security": {
      "type": "object",
      "properties": {
        "allowedNetworks": { "type": "array", "minItems": 1, "items": { "type": "string" } },
        "tls": {
          "type": "object",
          "properties": {
            "enabled": { "type": "boolean" },
            "requireClientCert": { "type": "boolean" }
          }
        }
      }
    },
    "backup": {
      "type": "object",
      "properties": {
        "enabled": { "type": "boolean" },
        "keepLocal": { "type": "integer", "minimum": 0 },
        "keepRemote": { "type": "integer", "minimum": 0 }
      }
    },
    "observability": {
      "type": "object",
      "properties": {
        "prometheus": { "type": "object", "properties": { "enabled": { "type": "boolean" } } },
        "alerts": {
          "type": "object",
          "properties": {
            "enabled": { "type": "boolean" },
            "for": {
              "type": "object",
              "properties": {
                "fast": { "type": "string", "pattern": "^[0-9]+(s|m|h)$" },
                "medium": { "type": "string", "pattern": "^[0-9]+(s|m|h)$" },
                "slow": { "type": "string", "pattern": "^[0-9]+(s|m|h)$" }
              }
            }
          }
        }
      }
    }
  }
}
