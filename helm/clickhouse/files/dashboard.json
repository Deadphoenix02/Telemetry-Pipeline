{
  "title": "ClickHouse telemetry store",
  "uid": "telemetry-store",
  "schemaVersion": 39,
  "version": 1,
  "time": {
    "from": "now-3h",
    "to": "now"
  },
  "refresh": "30s",
  "tags": [
    "clickhouse",
    "telemetry"
  ],
  "templating": {
    "list": [
      {
        "name": "datasource",
        "type": "datasource",
        "query": "prometheus",
        "label": "Data source"
      },
      {
        "name": "job",
        "type": "custom",
        "query": "__CH_JOB__",
        "current": {
          "text": "__CH_JOB__",
          "value": "__CH_JOB__"
        },
        "label": "ClickHouse job"
      },
      {
        "name": "keeper_job",
        "type": "custom",
        "query": "__KEEPER_JOB__",
        "current": {
          "text": "__KEEPER_JOB__",
          "value": "__KEEPER_JOB__"
        },
        "label": "Keeper job"
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "type": "timeseries",
      "title": "Rows inserted per second",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "rowsps"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(rate(ClickHouseProfileEvents_InsertedRows{job=~\"$job\"}[1m]))",
          "legendFormat": "cluster"
        },
        {
          "refId": "B",
          "expr": "rate(ClickHouseProfileEvents_InsertedRows{job=~\"$job\"}[1m])",
          "legendFormat": "{{instance}}"
        }
      ]
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "Failed inserts and queries per second",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "x": 12,
        "y": 0,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "reqps"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "rate(ClickHouseProfileEvents_FailedInsertQuery{job=~\"$job\"}[5m])",
          "legendFormat": "insert {{instance}}"
        },
        {
          "refId": "B",
          "expr": "rate(ClickHouseProfileEvents_FailedQuery{job=~\"$job\"}[5m])",
          "legendFormat": "query {{instance}}"
        }
      ]
    },
    {
      "id": 3,
      "type": "timeseries",
      "title": "Max parts in one partition",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "x": 0,
        "y": 8,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "ClickHouseAsyncMetrics_MaxPartCountForPartition{job=~\"$job\"}",
          "legendFormat": "{{instance}}"
        }
      ]
    },
    {
      "id": 4,
      "type": "timeseries",
      "title": "Merges running vs pool size",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "x": 12,
        "y": 8,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "ClickHouseMetrics_BackgroundMergesAndMutationsPoolTask{job=~\"$job\"}",
          "legendFormat": "running {{instance}}"
        },
        {
          "refId": "B",
          "expr": "ClickHouseMetrics_BackgroundMergesAndMutationsPoolSize{job=~\"$job\"}",
          "legendFormat": "pool {{instance}}"
        }
      ]
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "Replication delay (s)",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "x": 0,
        "y": 16,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "ClickHouseAsyncMetrics_ReplicasMaxAbsoluteDelay{job=~\"$job\"}",
          "legendFormat": "{{instance}}"
        }
      ]
    },
    {
      "id": 6,
      "type": "timeseries",
      "title": "Replication queue and read-only replicas",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "x": 12,
        "y": 16,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "ClickHouseAsyncMetrics_ReplicasMaxQueueSize{job=~\"$job\"}",
          "legendFormat": "queue {{instance}}"
        },
        {
          "refId": "B",
          "expr": "ClickHouseMetrics_ReadonlyReplica{job=~\"$job\"}",
          "legendFormat": "read-only {{instance}}"
        }
      ]
    },
    {
      "id": 7,
      "type": "timeseries",
      "title": "Memory resident vs limit",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "x": 0,
        "y": 24,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "bytes"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "ClickHouseAsyncMetrics_jemalloc_resident{job=~\"$job\"}",
          "legendFormat": "resident {{instance}}"
        },
        {
          "refId": "B",
          "expr": "ClickHouseAsyncMetrics_CGroupMemoryTotal{job=~\"$job\"}",
          "legendFormat": "limit {{instance}}"
        }
      ]
    },
    {
      "id": 8,
      "type": "timeseries",
      "title": "Disk free (fraction)",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "x": 12,
        "y": 24,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "ClickHouseAsyncMetrics_DiskAvailable_default{job=~\"$job\"} / ClickHouseAsyncMetrics_DiskTotal_default{job=~\"$job\"}",
          "legendFormat": "{{instance}}"
        }
      ]
    },
    {
      "id": 9,
      "type": "timeseries",
      "title": "Query time per second (s)",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "x": 0,
        "y": 32,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "rate(ClickHouseProfileEvents_QueryTimeMicroseconds{job=~\"$job\"}[5m]) / 1e6",
          "legendFormat": "{{instance}}"
        }
      ]
    },
    {
      "id": 10,
      "type": "timeseries",
      "title": "Keeper: sessions and members up",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "x": 12,
        "y": 32,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "ClickHouseMetrics_ZooKeeperSession{job=~\"$job\"}",
          "legendFormat": "session {{instance}}"
        },
        {
          "refId": "B",
          "expr": "sum(up{job=~\"$keeper_job\"})",
          "legendFormat": "keepers up"
        }
      ]
    }
  ]
}
